{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@capture-flow/core": ["packages/core/src/index.ts"],
      "@capture-flow/runtime": ["packages/runtime/src/index.ts"],
      "@capture-flow/hub-client": ["packages/hub-client/src/index.ts"],
      "@capture-flow/ui": ["packages/ui/src/index.ts"]
    }
  },
  "include": ["apps/**/*.ts", "packages/**/*.ts", "scripts/**/*.ts", "tests/**/*.ts"]
}
